# Base URL of the backend API (same-origin "/api" works with the Vite proxy and the nginx image)
VITE_API_BASE_URL=/api
# WebSocket base; leave empty to derive from the current origin (ws(s)://host/ws)
VITE_WS_BASE_URL=
# Backend the Vite dev server proxies /api and /ws to
VITE_DEV_PROXY_TARGET=http://localhost:8001
