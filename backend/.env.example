# ---- Django core ----
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
DEMO_MODE=True
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173

# ---- Database / cache / broker ----
DATABASE_URL=postgres://schoolbus:schoolbus@localhost:5432/schoolbus
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Run Celery tasks inline (no worker needed): True for a plain local venv, False when a worker runs (Docker). Never True in production.
CELERY_TASK_ALWAYS_EAGER=True

# ---- CORS / CSRF ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- JWT ----
ACCESS_TOKEN_MINUTES=20
REFRESH_TOKEN_DAYS=14

# ---- Email (console backend prints emails to the server log) ----
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=SchoolBus Pro <no-reply@schoolbuspro.local>

# ---- SMS / WhatsApp provider interface ("console" logs messages; see apps/notifications/providers.py) ----
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console

# ---- Web push (generate with: python manage.py generate_vapid_keys) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@example.com

# ---- Payments ("mock" = simulated sandbox gateway, never collects money) ----
PAYMENT_GATEWAY=mock
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# ---- Transport domain tuning ----
ARRIVAL_ALERT_MINUTES=10
GPS_STALE_SECONDS=120
GPS_MAX_ACCURACY_METERS=250
DRIVER_LOCATION_INTERVAL_SECONDS=10
ETA_DEFAULT_SPEED_KMH=22
