# ---- Django core ----
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
DEMO_MODE=False
ALLOWED_HOSTS=bus.example.com
HEALTHCHECK_HOST=bus.example.com
FRONTEND_URL=https://bus.example.com

# ---- Database / cache / broker ----
POSTGRES_USER=schoolbus
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=schoolbus
DATABASE_URL=postgres://schoolbus:CHANGE_ME@postgres:5432/schoolbus
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
# Run Celery tasks inline (no worker needed). Fine for local dev, never in production.
CELERY_TASK_ALWAYS_EAGER=False

# ---- CORS / CSRF ----
CORS_ALLOWED_ORIGINS=https://bus.example.com
CSRF_TRUSTED_ORIGINS=https://bus.example.com

# ---- JWT ----
ACCESS_TOKEN_MINUTES=20
REFRESH_TOKEN_DAYS=14

# ---- Email (console backend prints emails to the server log) ----
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=SchoolBus Pro <no-reply@schoolbuspro.local>

# ---- SMS / WhatsApp provider interface ("console" logs messages; see apps/notifications/providers.py) ----
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console

# ---- Web push (generate with: python manage.py generate_vapid_keys) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@example.com

# ---- Payments ("mock" = simulated sandbox gateway, never collects money) ----
PAYMENT_GATEWAY=mock
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# ---- Transport domain tuning ----
ARRIVAL_ALERT_MINUTES=10
GPS_STALE_SECONDS=120
GPS_MAX_ACCURACY_METERS=250
DRIVER_LOCATION_INTERVAL_SECONDS=10
ETA_DEFAULT_SPEED_KMH=22
